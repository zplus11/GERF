Cell[TextData[{
 "Note that after applying the wave transformation ",
 Cell[BoxData[
  RowBox[{
   StyleBox["\[Eta]", "TR"], "=", 
   RowBox[{
    StyleBox["x", "TI"], "-", 
    RowBox[{
     StyleBox["c", "TI"], " ", 
     StyleBox["t", "TI"]}]}]}]], "InlineFormula",ExpressionUUID->
  "9c3574f9-db93-bf41-b7b7-dcd21a92fc3c"],
 " it becomes"
}], "ExampleText",
