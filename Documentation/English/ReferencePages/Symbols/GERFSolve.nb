Cell["\<\
Consider the system of equations considered in \
https://doi.org/10.1007/s13324-023-00802-0 by Kumar et al:\
\>", "ExampleText",
 CellChangeTimes->{{3.9911160950557976`*^9, 3.991116121235649*^9}, {
  3.991116169996212*^9, 3.991116170642662*^9}, {3.991116203481695*^9, 
  3.991116204642824*^9}},
 CellID->806887797,ExpressionUUID->"0d994098-073f-0641-a1c5-ef241ea7ef1d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"system2", "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{
       SubscriptBox["\[PartialD]", "y"], 
       RowBox[{"u", "[", 
        RowBox[{"x", ",", "y", ",", "t"}], "]"}]}], "==", 
      RowBox[{
       SubscriptBox["\[PartialD]", "x"], 
       RowBox[{"v", "[", 
        RowBox[{"x", ",", "y", ",", "t"}], "]"}]}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{
        SubscriptBox["\[PartialD]", "t"], 
        RowBox[{"u", "[", 
         RowBox[{"x", ",", "y", ",", "t"}], "]"}]}], "-", 
       RowBox[{
        SubscriptBox["\[PartialD]", 
         RowBox[{"x", ",", "x", ",", "x"}]], 
        RowBox[{"u", "[", 
         RowBox[{"x", ",", "y", ",", "t"}], "]"}]}], "-", 
       RowBox[{"6", "b", " ", 
        RowBox[{"u", "[", 
         RowBox[{"x", ",", "y", ",", "t"}], "]"}], 
        RowBox[{
         SubscriptBox["\[PartialD]", "x"], 
         RowBox[{"u", "[", 
          RowBox[{"x", ",", "y", ",", "t"}], "]"}]}]}], "+", 
       RowBox[{
        FractionBox["3", "2"], 
        SuperscriptBox["\[Alpha]", 
         RowBox[{"2", " "}]], 
        SuperscriptBox[
         RowBox[{"u", "[", 
          RowBox[{"x", ",", "y", ",", "t"}], "]"}], "2"], 
        RowBox[{
         SubscriptBox["\[PartialD]", "x"], 
         RowBox[{"u", "[", 
          RowBox[{"x", ",", "y", ",", "t"}], "]"}]}]}], "-", 
       RowBox[{"3", 
        RowBox[{
         SubscriptBox["\[PartialD]", "y"], 
         RowBox[{"v", "[", 
          RowBox[{"x", ",", "y", ",", "t"}], "]"}]}]}], "+", 
       RowBox[{"3", "a", 
        RowBox[{
         SubscriptBox["\[PartialD]", "x"], 
         RowBox[{"u", "[", 
          RowBox[{"x", ",", "y", ",", "t"}], "]"}]}], 
        RowBox[{"v", "[", 
         RowBox[{"x", ",", "y", ",", "t"}], "]"}]}]}], "==", "0"}]}], 
    "\[IndentingNewLine]", "}"}]}], ";"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->183051081,ExpressionUUID->"66195e55-4a1a-f647-99e7-53adb46eecb1"],

Cell[TextData[{
 "For ease of computation, let us take ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Alpha]", "=", 
    RowBox[{"a", "=", 
     RowBox[{"b", "=", "1"}]}]}], TraditionalForm]],ExpressionUUID->
  "61d10ebb-7fb3-e34f-8e37-af6be21f2602"],
 ". Then,"
}], "ExampleText",
 CellChangeTimes->{3.9911161417118874`*^9},
 CellID->803477448,ExpressionUUID->"d7221ad6-d743-584f-a6fa-6184dd09e835"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"GERFSolve", "[", 
    RowBox[{
     RowBox[{"system2", "/.", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\[Alpha]", "->", "1"}], ",", 
        RowBox[{"a", "->", "1"}], ",", 
        RowBox[{"b", "->", "1"}]}], "}"}]}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"u", "[", 
        RowBox[{"x", ",", "y", ",", "t"}], "]"}], ",", 
       RowBox[{"v", "[", 
        RowBox[{"x", ",", "y", ",", "t"}], "]"}]}], "}"}], ",", 
     RowBox[{"\"\<BalanceConstant\>\"", "->", 
      RowBox[{"{", 
       RowBox[{"1", ",", "1"}], "}"}]}], ",", 
     RowBox[{"\"\<RationalFunction\>\"", "->", 
      RowBox[{"Function", "[", 
       RowBox[{"n", ",", 
        RowBox[{
         RowBox[{"Coth", "[", "n", "]"}], "-", "2"}]}], "]"}]}], ",", 
     RowBox[{"\"\<OutputMode\>\"", "->", "All"}]}], "]"}], "[", 
   RowBox[{"[", "1", "]"}], "]"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{"displaying", " ", "only", " ", "one"}], " ", "*)"}]}]], "Input",
 CellLabel->"In[2]:=",
 CellID->223749164,ExpressionUUID->"2ce263d0-7938-4942-a43a-2c1281ed3590"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      TemplateBox[{"\[ScriptCapitalA]", 
        RowBox[{"-", "1"}], "u"},
       "Subsuperscript"], "\[Rule]", 
      RowBox[{
       RowBox[{"-", "6"}], " ", 
       SubscriptBox["\[ScriptW]", "x"]}]}], ",", 
     RowBox[{
      TemplateBox[{"\[ScriptCapitalA]", 
        RowBox[{"-", "1"}], "v"},
       "Subsuperscript"], "\[Rule]", 
      RowBox[{"6", " ", 
       SubscriptBox["\[ScriptW]", "x"], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "2"}], "+", 
         RowBox[{"4", " ", 
          SubscriptBox["\[ScriptW]", "x"]}], "+", 
         TemplateBox[{"\[ScriptCapitalA]", "0", "u"},
          "Subsuperscript"]}], ")"}]}]}], ",", 
     RowBox[{
      TemplateBox[{"\[ScriptCapitalA]", "1", "u"},
       "Subsuperscript"], "\[Rule]", "0"}], ",", 
     RowBox[{
      TemplateBox[{"\[ScriptCapitalA]", "1", "v"},
       "Subsuperscript"], "\[Rule]", "0"}], ",", 
     RowBox[{
      SubscriptBox["\[ScriptW]", "t"], "\[Rule]", 
      RowBox[{
       FractionBox["1", "2"], " ", 
       SubscriptBox["\[ScriptW]", "x"], " ", 
       RowBox[{"(", 
        RowBox[{"24", "-", 
         RowBox[{"96", " ", 
          SubscriptBox["\[ScriptW]", "x"]}], "+", 
         RowBox[{"140", " ", 
          SubsuperscriptBox["\[ScriptW]", "x", "2"]}], "-", 
         RowBox[{"12", " ", 
          TemplateBox[{"\[ScriptCapitalA]", "0", "u"},
           "Subsuperscript"]}], "+", 
         RowBox[{"48", " ", 
          SubscriptBox["\[ScriptW]", "x"], " ", 
          TemplateBox[{"\[ScriptCapitalA]", "0", "u"},
           "Subsuperscript"]}], "+", 
         RowBox[{"3", " ", 
          SuperscriptBox[
           RowBox[{"(", 
            TemplateBox[{"\[ScriptCapitalA]", "0", "u"},
             "Subsuperscript"], ")"}], "2"]}], "-", 
         RowBox[{"6", " ", 
          TemplateBox[{"\[ScriptCapitalA]", "0", "v"},
           "Subsuperscript"]}]}], ")"}]}]}], ",", 
     RowBox[{
      SubscriptBox["\[ScriptW]", "y"], "\[Rule]", 
      RowBox[{
       RowBox[{"2", " ", 
        SubscriptBox["\[ScriptW]", "x"]}], "-", 
       RowBox[{"4", " ", 
        SubsuperscriptBox["\[ScriptW]", "x", "2"]}], "-", 
       RowBox[{
        SubscriptBox["\[ScriptW]", "x"], " ", 
        TemplateBox[{"\[ScriptCapitalA]", "0", "u"},
         "Subsuperscript"]}]}]}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"u", "[", 
       RowBox[{"x", ",", "y", ",", "t"}], "]"}], "\[Rule]", 
      RowBox[{
       RowBox[{"-", 
        RowBox[{"(", 
