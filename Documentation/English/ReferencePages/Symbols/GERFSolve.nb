Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"sols", "=", 
  RowBox[{"GERFSolve", "[", 
   RowBox[{"burgers", ",", 
    RowBox[{"u", "[", 
     RowBox[{"x", ",", "t"}], "]"}], ",", 
    RowBox[{"\"\<OutputMode\>\"", "->", "All"}]}], "]"}]}]], "Input",
 TaggingRules->{},
