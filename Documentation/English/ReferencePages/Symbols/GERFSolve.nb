Cell[BoxData[
 RowBox[{
  RowBox[{"sys", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        SubscriptBox["\[PartialD]", 
         RowBox[{"x", ",", "x"}]], 
        RowBox[{"u", "[", 
         RowBox[{"x", ",", "t"}], "]"}]}], "-", 
       RowBox[{"u", "[", 
        RowBox[{"x", ",", "t"}], "]"}], "+", 
       RowBox[{"2", 
        SuperscriptBox[
         RowBox[{"v", "[", 
          RowBox[{"x", ",", "t"}], "]"}], "3"]}]}], "==", "0"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{
        SubscriptBox["\[PartialD]", 
         RowBox[{"x", ",", "x"}]], 
        RowBox[{"v", "[", 
         RowBox[{"x", ",", "t"}], "]"}]}], "-", 
       RowBox[{"v", "[", 
        RowBox[{"x", ",", "t"}], "]"}], "+", 
       RowBox[{"2", 
        SuperscriptBox[
         RowBox[{"u", "[", 
          RowBox[{"x", ",", "t"}], "]"}], "3"]}]}], "==", "0"}]}], "}"}]}], 
  ";"}]], "Input",
