Cell["\<\
As long as the \"rational function\" is truly exponential rational, GERFSolve \
will most likely not fail to work.\
\>", "ExampleText",
 CellChangeTimes->{{3.9911166093605957`*^9, 3.991116633643181*^9}},
 CellID->7380697,ExpressionUUID->"0d7dc6d4-d575-4241-bdac-4032697f446d"]
}, Open  ]]
