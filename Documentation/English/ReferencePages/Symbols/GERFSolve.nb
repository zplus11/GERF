Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Eta]", "[", 
   RowBox[{"x_", ",", "t_"}], "]"}], ":=", 
  RowBox[{"x", "-", 
   RowBox[{"c", " ", "t"}]}]}], "\[IndentingNewLine]", 
 RowBox[{"sys2", "=", 
  RowBox[{
   RowBox[{"sys", "/.", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"u", "->", 
       RowBox[{"U", "@*", "\[Eta]"}]}], ",", 
      RowBox[{"v", "->", 
       RowBox[{"V", "@*", "\[Eta]"}]}]}], "}"}]}], "/.", 
   RowBox[{
    RowBox[{"\[Eta]", "[", 
     RowBox[{"x", ",", "t"}], "]"}], "->", "\[Eta]"}]}]}]}], "Input",
