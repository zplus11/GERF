Cell["\<\
Karmina et al in https://doi.org/10.1016/j.chaos.2022.112381 considered the \
following system of equations:\
\>", "ExampleText",
 CellChangeTimes->{{3.9911162767447205`*^9, 3.991116294089817*^9}},
 CellID->112871176,ExpressionUUID->"98c17f12-cf42-7c4b-8c1a-707d0e8651e8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"eqns", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"I", " ", 
        RowBox[{
         SubscriptBox["\[PartialD]", "t"], 
         RowBox[{"e", "[", 
          RowBox[{"x", ",", "t"}], "]"}]}]}], "+", 
       RowBox[{
        FractionBox["1", "2"], 
        RowBox[{
         SubscriptBox["\[PartialD]", 
          RowBox[{"x", ",", "x"}]], 
         RowBox[{"e", "[", 
          RowBox[{"x", ",", "t"}], "]"}]}]}], "-", 
       RowBox[{
        RowBox[{"n", "[", 
         RowBox[{"x", ",", "t"}], "]"}], 
        RowBox[{"e", "[", 
         RowBox[{"x", ",", "t"}], "]"}]}]}], "==", "0"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{
        SubscriptBox["\[PartialD]", 
         RowBox[{"t", ",", "t"}]], 
        RowBox[{"n", "[", 
         RowBox[{"x", ",", "t"}], "]"}]}], "-", 
       RowBox[{
        SubscriptBox["\[PartialD]", 
         RowBox[{"x", ",", "x"}]], 
        RowBox[{"n", "[", 
         RowBox[{"x", ",", "t"}], "]"}]}], "-", 
       RowBox[{"2", 
        RowBox[{
         SubscriptBox["\[PartialD]", 
          RowBox[{"x", ",", "x"}]], 
         SuperscriptBox[
          RowBox[{"Abs", "[", 
           RowBox[{"e", "[", 
            RowBox[{"x", ",", "t"}], "]"}], "]"}], "2"]}]}]}], "==", "0"}]}], 
    "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.99111630378697*^9, 3.9911163076084747`*^9}},
 CellLabel->"In[1]:=",
 CellID->109993403,ExpressionUUID->"b2eeb22b-1437-b543-b596-ce8a5bfb372b"],

Cell[TextData[{
 "For our purposes let us replace ",
 Cell[BoxData[
  RowBox[{"|", 
   RowBox[{
    StyleBox["e", "TI"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["x", "TI"], ",", 
      StyleBox["t", "TI"]}], ")"}]}], "|"}]], "InlineFormula",ExpressionUUID->
  "101678fc-2bb9-9f4e-871c-5fc0a564a6c5"],
 " by ",
 Cell[BoxData[
  RowBox[{
   StyleBox["e", "TI"], 
   RowBox[{"(", 
    RowBox[{
     StyleBox["x", "TI"], ",", 
     StyleBox["t", "TI"]}], ")"}]}]], "InlineFormula",ExpressionUUID->
  "786f61ee-7a80-b648-b6a5-7fd37f1a4488"],
 ". Then, solving it using ",
 Cell[BoxData[
  ButtonBox["JacobiSN",
   BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
  "90377a07-0693-6343-b25a-08681da6b5bb"],
 " in place of the rational function:"
}], "ExampleText",
 CellChangeTimes->{{3.9911163114358253`*^9, 3.991116422420223*^9}},
 CellID->18441140,ExpressionUUID->"17d7db6a-15c0-3b41-b72a-3432de40cddf"],

