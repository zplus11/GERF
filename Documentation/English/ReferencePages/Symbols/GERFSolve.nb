        RowBox[{"n", "[", 
         RowBox[{"x", ",", "t"}], "]"}], 
        RowBox[{"e", "[", 
         RowBox[{"x", ",", "t"}], "]"}]}]}], "==", "0"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{
        SubscriptBox["\[PartialD]", 
         RowBox[{"t", ",", "t"}]], 
        RowBox[{"n", "[", 
