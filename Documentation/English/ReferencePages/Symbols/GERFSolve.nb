      RowBox[{
       SubscriptBox["\[ScriptCapitalA]", "1"], "->", 
       RowBox[{"-", "1"}]}], ",", 
      RowBox[{
       SubscriptBox["\[ScriptW]", "x"], "->", 
       RowBox[{"-", "1"}]}]}], "}"}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
