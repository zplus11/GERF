Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"RandomChoice", "@", 
  RowBox[{"GERFSolve", "[", 
   RowBox[{"eqns", ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"e", "[", 
       RowBox[{"x", ",", "t"}], "]"}], ",", 
      RowBox[{"n", "[", 
       RowBox[{"x", ",", "t"}], "]"}]}], "}"}], ",", 
    RowBox[{"\"\<RationalFunction\>\"", "->", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"JacobiSN", "[", 
        RowBox[{"#", ",", "1"}], "]"}], "&"}], ")"}]}], ",", 
    RowBox[{"\"\<WaveConstants\>\"", "->", 
     RowBox[{"{", 
      RowBox[{"1", ",", 
       RowBox[{"-", "c"}]}], "}"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.991116431382454*^9, 3.9911165073321705`*^9}},
 CellLabel->"In[5]:=",
 CellID->342279929,ExpressionUUID->"536ccf4d-38b4-1f4d-9496-8cd2cbcc67aa"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{"e", "[", 
     RowBox[{"x", ",", "t"}], "]"}], "\[Rule]", 
    RowBox[{
     RowBox[{"\[ImaginaryI]", " ", 
      SqrtBox["5"]}], "+", 
     RowBox[{
      SqrtBox["5"], " ", 
      RowBox[{"Cot", "[", 
       RowBox[{
        RowBox[{"3", " ", "t"}], "-", 
        RowBox[{"\[ImaginaryI]", " ", "x"}]}], "]"}]}]}]}], ",", 
   RowBox[{
    RowBox[{"n", "[", 
     RowBox[{"x", ",", "t"}], "]"}], "\[Rule]", 
    RowBox[{
     RowBox[{"-", "3"}], "-", 
     RowBox[{"2", " ", "\[ImaginaryI]", " ", 
      RowBox[{"Cot", "[", 
       RowBox[{
        RowBox[{"3", " ", "t"}], "-", 
        RowBox[{"\[ImaginaryI]", " ", "x"}]}], "]"}]}], "-", 
     SuperscriptBox[
      RowBox[{"Cot", "[", 
       RowBox[{
        RowBox[{"3", " ", "t"}], "-", 
        RowBox[{"\[ImaginaryI]", " ", "x"}]}], "]"}], "2"]}]}]}], 
  "}"}]], "Output",
 CellChangeTimes->{{3.991116466847471*^9, 3.991116516062996*^9}, {
