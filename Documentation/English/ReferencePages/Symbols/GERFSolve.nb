Cell[BoxData[
 RowBox[{"GERFSolve", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"u", "''"}], "[", "\[Eta]", "]"}], "+", 
     RowBox[{"3", 
      SuperscriptBox[
       RowBox[{"u", "[", "\[Eta]", "]"}], "2"]}], "-", 
     RowBox[{"2", 
      SuperscriptBox[
       RowBox[{"u", "[", "\[Eta]", "]"}], "3"]}], "-", 
     RowBox[{"u", "[", "\[Eta]", "]"}]}], "==", "0"}], ",", 
   RowBox[{"u", "[", "\[Eta]", "]"}], ",", 
   RowBox[{"\"\<WaveConstants\>\"", "->", 
