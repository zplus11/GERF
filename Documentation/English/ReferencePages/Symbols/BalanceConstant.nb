Cell["Balance constant of a system:", "ExampleText",
 CellChangeTimes->{{3.997599428601612*^9, 3.9975994325326996`*^9}},
 CellID->46565534,ExpressionUUID->"2c24fcfc-afe2-b546-8e90-8b347c2a3059"],

Cell[BoxData[
 RowBox[{
  RowBox[{"sys", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"I", " ", 
        RowBox[{
         SubscriptBox["\[PartialD]", "t"], 
         RowBox[{"e", "[", 
          RowBox[{"x", ",", "t"}], "]"}]}]}], "+", 
       RowBox[{
        FractionBox["1", "2"], 
        RowBox[{
         SubscriptBox["\[PartialD]", 
          RowBox[{"x", ",", "x"}]], 
         RowBox[{"e", "[", 
          RowBox[{"x", ",", "t"}], "]"}]}]}], "-", 
       RowBox[{
        RowBox[{"n", "[", 
         RowBox[{"x", ",", "t"}], "]"}], 
        RowBox[{"e", "[", 
         RowBox[{"x", ",", "t"}], "]"}]}]}], "==", "0"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{
        SubscriptBox["\[PartialD]", 
         RowBox[{"t", ",", "t"}]], 
        RowBox[{"n", "[", 
         RowBox[{"x", ",", "t"}], "]"}]}], "-", 
       RowBox[{
        SubscriptBox["\[PartialD]", 
         RowBox[{"x", ",", "x"}]], 
        RowBox[{"n", "[", 
         RowBox[{"x", ",", "t"}], "]"}]}], "-", 
       RowBox[{"2", 
        RowBox[{
         SubscriptBox["\[PartialD]", 
          RowBox[{"x", ",", "x"}]], 
         SuperscriptBox[
          RowBox[{"e", "[", 
           RowBox[{"x", ",", "t"}], "]"}], "2"]}]}]}], "==", "0"}]}], "}"}]}],
   ";"}]], "Input",
 CellChangeTimes->{{3.9975994938218937`*^9, 3.997599496585785*^9}},
 CellLabel->"In[16]:=",
 CellID->653891197,ExpressionUUID->"511af16d-0264-5246-a5a9-1caf2309e61f"],

Cell[CellGroupData[{

Cell[BoxData[
